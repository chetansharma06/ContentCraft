# ContentCraft Application Configuration
# Copy this file to .env and fill in your values. Never commit .env!

# LLM Provider: mock | gemini | ollama
LLM_PROVIDER=mock

# Gemini settings (required when LLM_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# Ollama settings (required when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434

# Database
DATABASE_URL=sqlite:///./content_craft.db

# Concurrency and retries
MAX_CONCURRENCY=5
MAX_RETRIES=3

# Default language for content generation
DEFAULT_LANGUAGE=en

# Development server addresses
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=5173
# Optional comma-separated CORS origins; defaults to the configured frontend URL
# CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Frontend API configuration
VITE_API_BASE_URL=/api
# VITE_BACKEND_URL is set by the root startup command from BACKEND_HOST/BACKEND_PORT
